{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "SlimPAR 64 RGBA",
  "categories": ["Color Changer"],
  "meta": {
    "authors": ["Aaron Geiser"],
    "createDate": "2026-10-23",
    "lastModifyDate": "2026-10-23"
  },
  "links": {
    "manual": [
      "https://www.chauvetdj.com/wp-content/uploads/2015/09/SlimPAR_64_RGBA_UM_Rev2_WO.pdf"
    ],
    "productPage": [
      "https://www.chauvetdj.com/products/slimpar-64-rgba/"
    ]
  },
  "physical": {
    "dimensions": [276, 66, 275],
    "weight": 1.3,
    "power": 30,
    "DMXconnector": "3-pin",
    "bulb": {
      "type": "180× ¼W RGBA LED"
    },
    "lens": {
      "degreesMinMax": [14, 23]
    }
  },
  "availableChannels": {
    "Red": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Red"
      }
    },
    "Green": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Green"
      }
    },
    "Blue": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Blue"
      }
    },
    "Amber": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Amber"
      }
    },
    "Color Macros": {
      "capabilities": [
        {
          "dmxRange": [0, 15],
          "type": "NoFunction"
        },
        {
          "dmxRange": [16, 255],
          "type": "ColorPreset",
          "comment": "Color macros (overrides channels 1–4)"
        }
      ]
    },
    "Strobe": {
      "capabilities": [
        {
          "dmxRange": [0, 15],
          "type": "NoFunction",
          "comment": "No strobe"
        },
        {
          "dmxRange": [16, 255],
          "type": "ShutterStrobe",
          "shutterEffect": "Strobe",
          "speedStart": "slow",
          "speedEnd": "fast"
        }
      ]
    },
    "Effect Speed": {
      "capability": {
        "type": "EffectSpeed",
        "speedStart": "slow",
        "speedEnd": "fast"
      }
    },
    "Mode": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 31],
          "type": "NoFunction",
          "switchChannels": {
            "Speed / Strobe": "Strobe"
          }
        },
        {
          "dmxRange": [32, 63],
          "type": "Effect",
          "effectName": "Pulse",
          "comment": "Pulse 0%→100%",
          "switchChannels": {
            "Speed / Strobe": "Effect Speed"
          }
        },
        {
          "dmxRange": [64, 95],
          "type": "Effect",
          "effectName": "Pulse",
          "comment": "Pulse 100%→0%",
          "switchChannels": {
            "Speed / Strobe": "Effect Speed"
          }
        },
        {
          "dmxRange": [96, 127],
          "type": "Effect",
          "effectName": "Pulse",
          "comment": "Pulse 100%→0%→100%",
          "switchChannels": {
            "Speed / Strobe": "Effect Speed"
          }
        },
        {
          "dmxRange": [128, 159],
          "type": "Effect",
          "effectPreset": "ColorFade",
          "switchChannels": {
            "Speed / Strobe": "Effect Speed"
          }
        },
        {
          "dmxRange": [160, 191],
          "type": "Effect",
          "effectPreset": "ColorJump",
          "comment": "4 colors",
          "switchChannels": {
            "Speed / Strobe": "Effect Speed"
          }
        },
        {
          "dmxRange": [192, 223],
          "type": "Effect",
          "effectPreset": "ColorJump",
          "comment": "15 colors",
          "switchChannels": {
            "Speed / Strobe": "Effect Speed"
          }
        },
        {
          "dmxRange": [224, 255],
          "type": "Effect",
          "effectName": "Sound-active mode",
          "soundControlled": true,
          "switchChannels": {
            "Speed / Strobe": "Strobe"
          }
        }
      ]
    },
    "Dimmer": {
      "capability": {
        "type": "Intensity"
      }
    }
  },
  "modes": [
    {
      "name": "4-channel",
      "shortName": "4ch",
      "channels": [
        "Red",
        "Green",
        "Blue",
        "Amber"
      ]
    },
    {
      "name": "8-channel",
      "shortName": "8ch",
      "channels": [
        "Red",
        "Green",
        "Blue",
        "Amber",
        "Color Macros",
        "Speed / Strobe",
        "Mode",
        "Dimmer"
      ]
    }
  ]
}
