{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "EZpar T6 USB",
  "categories": ["Color Changer"],
  "meta": {
    "authors": ["Lawrence Carrillo"],
    "createDate": "2026-10-19",
    "lastModifyDate": "2026-10-19"
  },
  "links": {
    "manual": [
      "https://www.chauvetdj.com/wp-content/uploads/2016/09/EZpar_T6_USB_UM_Rev2_WO.pdf",
      "https://r2.gear4music.com/media/25/253952/download_253952.pdf"
    ]
  },
  "physical": {
    "dimensions": [180, 231, 105],
    "weight": 1.7,
    "power": 22,
    "DMXconnector": "3-pin",
    "bulb": {
      "type": "6× 3W RGB LED"
    },
    "lens": {
      "degreesMinMax": [19, 19]
    }
  },
  "availableChannels": {
    "Red": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "Red"
      }
    },
    "Green": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "Green"
      }
    },
    "Blue": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "Blue"
      }
    },
    "Color Macros": {
      "capabilities": [
        {
          "dmxRange": [0, 15],
          "type": "NoFunction"
        },
        {
          "dmxRange": [16, 255],
          "type": "ColorPreset",
          "helpWanted": "Which colors can be selected at which DMX values?"
        }
      ]
    },
    "Strobe": {
      "capabilities": [
        {
          "dmxRange": [0, 15],
          "type": "NoFunction"
        },
        {
          "dmxRange": [16, 255],
          "type": "ShutterStrobe",
          "shutterEffect": "Strobe",
          "speedStart": "slow",
          "speedEnd": "fast"
        }
      ]
    },
    "Program Speed": {
      "capability": {
        "type": "EffectSpeed",
        "speedStart": "slow",
        "speedEnd": "fast"
      }
    },
    "Programs": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 31],
          "type": "NoFunction",
          "switchChannels": {
            "Strobe / Program Speed": "Strobe"
          }
        },
        {
          "dmxRange": [32, 63],
          "type": "Effect",
          "effectName": "Fade up",
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        },
        {
          "dmxRange": [64, 95],
          "type": "Effect",
          "effectName": "Fade down",
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        },
        {
          "dmxRange": [96, 127],
          "type": "Effect",
          "effectName": "Fade up/down",
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        },
        {
          "dmxRange": [128, 159],
          "type": "Effect",
          "effectPreset": "ColorFade",
          "comment": "7 colors",
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        },
        {
          "dmxRange": [160, 191],
          "type": "Effect",
          "effectPreset": "ColorJump",
          "comment": "3 colors",
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        },
        {
          "dmxRange": [192, 223],
          "type": "Effect",
          "effectPreset": "ColorJump",
          "comment": "7 colors",
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        },
        {
          "dmxRange": [224, 255],
          "type": "Effect",
          "effectName": "Sound active",
          "soundControlled": true,
          "switchChannels": {
            "Strobe / Program Speed": "Program Speed"
          }
        }
      ]
    },
    "Dimmer": {
      "capability": {
        "type": "Intensity"
      }
    }
  },
  "modes": [
    {
      "name": "3-channel",
      "shortName": "3ch",
      "channels": [
        "Red",
        "Green",
        "Blue"
      ]
    },
    {
      "name": "7-channel",
      "shortName": "7ch",
      "channels": [
        "Red",
        "Green",
        "Blue",
        "Color Macros",
        "Strobe / Program Speed",
        "Programs",
        "Dimmer"
      ]
    }
  ]
}
