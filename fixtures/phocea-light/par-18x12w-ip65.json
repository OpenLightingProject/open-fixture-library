{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "PAR 18x12W IP65",
  "categories": ["Color Changer"],
  "meta": {
    "authors": ["Dario", "Flo Edelmann"],
    "createDate": "2026-07-31",
    "lastModifyDate": "2026-07-31"
  },
  "links": {
    "manual": [
      "https://www.phocealight.fr/wp-content/uploads/2024/08/Manuel-dutilisation-PAR-18x12W-IP-65-Phocea-Light.pdf"
    ],
    "productPage": [
      "https://www.phocealight.fr/produit/par-18x12w-ip65-2/"
    ]
  },
  "physical": {
    "dimensions": [310, 310, 130],
    "weight": 3.9,
    "power": 160,
    "DMXconnector": "3-pin XLR IP65",
    "bulb": {
      "type": "18×12W RGBWA 5-in-1 LEDs"
    },
    "lens": {
      "degreesMinMax": [25, 25]
    }
  },
  "availableChannels": {
    "Master Dimmer": {
      "capability": {
        "type": "Intensity"
      }
    },
    "Red": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Red"
      }
    },
    "Green": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Green"
      }
    },
    "Blue": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Blue"
      }
    },
    "White": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "White"
      }
    },
    "Amber": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Amber"
      }
    },
    "Strobe": {
      "capability": {
        "type": "ShutterStrobe",
        "shutterEffect": "Strobe",
        "speedStart": "slow",
        "speedEnd": "fast",
        "helpWanted": "At which DMX values is strobe disabled? When is the lamp constantly on/off?"
      }
    },
    "Program": {
      "capabilities": [
        {
          "dmxRange": [0, 50],
          "type": "NoFunction",
          "comment": "Manual RGBWA control"
        },
        {
          "dmxRange": [51, 100],
          "type": "ColorPreset",
          "comment": "Static Color",
          "helpWanted": "Which colors can be selected at which DMX values?"
        },
        {
          "dmxRange": [101, 150],
          "type": "Effect",
          "effectPreset": "ColorJump"
        },
        {
          "dmxRange": [151, 200],
          "type": "Effect",
          "effectPreset": "ColorFade"
        },
        {
          "dmxRange": [201, 250],
          "type": "Effect",
          "effectName": "Color Pulse"
        },
        {
          "dmxRange": [251, 255],
          "type": "Effect",
          "effectName": "Sound Active",
          "soundControlled": true
        }
      ]
    },
    "Program Speed": {
      "capability": {
        "type": "EffectSpeed",
        "speedStart": "slow",
        "speedEnd": "fast"
      }
    }
  },
  "modes": [
    {
      "name": "5-channel",
      "shortName": "5ch",
      "channels": [
        "Red",
        "Green",
        "Blue",
        "White",
        "Amber"
      ]
    },
    {
      "name": "9-channel",
      "shortName": "9ch",
      "channels": [
        "Master Dimmer",
        "Red",
        "Green",
        "Blue",
        "White",
        "Amber",
        "Strobe",
        "Program",
        "Program Speed"
      ]
    }
  ]
}
