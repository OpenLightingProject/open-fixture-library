{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "LED-Bar 9xRGBW",
  "categories": ["Color Changer"],
  "meta": {
    "authors": ["justme"],
    "createDate": "2026-11-04",
    "lastModifyDate": "2026-11-04"
  },
  "links": {
    "manual": [
      "http://aliexpress.com"
    ],
    "productPage": [
      "http://aliexpress.come"
    ],
    "video": [
      "http://aliexpress.com"
    ]
  },
  "physical": {
    "DMXconnector": "3-pin",
    "bulb": {
      "type": "LED"
    }
  },
  "availableChannels": {
    "Dimmer RED": {
      "capability": {
        "type": "Intensity"
      }
    },
    "Dimmer GREEN": {
      "capability": {
        "type": "Intensity"
      }
    },
    "Dimmer BLUE": {
      "capability": {
        "type": "Intensity"
      }
    },
    "Dimmer WHITE": {
      "capability": {
        "type": "Intensity"
      }
    },
    "Dimmer MAIN": {
      "capability": {
        "type": "Intensity"
      }
    },
    "Strobe Speed": {
      "capability": {
        "type": "StrobeSpeed",
        "speedStart": "5Hz",
        "speedEnd": "60Hz"
      }
    },
    "Function": {
      "capabilities": [
        {
          "dmxRange": [0, 50],
          "type": "EffectParameter",
          "parameterStart": "low",
          "parameterEnd": "high",
          "comment": "CH1 to CH6 steered"
        },
        {
          "dmxRange": [51, 100],
          "type": "ColorPreset",
          "comment": "different colos controlled by CH8"
        },
        {
          "dmxRange": [101, 150],
          "type": "ColorPreset",
          "comment": "colors jumping"
        },
        {
          "dmxRange": [151, 200],
          "type": "ColorPreset",
          "comment": "abgestufte Farbwechel"
        },
        {
          "dmxRange": [201, 250],
          "type": "ColorPreset",
          "comment": "color changing pulsed"
        },
        {
          "dmxRange": [251, 255],
          "type": "Generic",
          "comment": "Sound control active"
        }
      ]
    },
    "Function control": {
      "capability": {
        "type": "EffectSpeed",
        "speedStart": "slow",
        "speedEnd": "fast",
        "comment": "used for additional Control of CH7"
      }
    }
  },
  "modes": [
    {
      "name": "4ch",
      "channels": [
        "Dimmer RED",
        "Dimmer GREEN",
        "Dimmer BLUE",
        "Dimmer WHITE"
      ]
    },
    {
      "name": "8ch",
      "channels": [
        "Dimmer MAIN",
        "Dimmer RED",
        "Dimmer GREEN",
        "Dimmer BLUE",
        "Dimmer WHITE",
        "Strobe Speed",
        "Function",
        "Function control"
      ]
    }
  ]
}
