{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "LED-Bar 9xRGBW",
  "categories": ["Dimmer", "Color Changer"],
  "meta": {
    "authors": ["justme"],
    "createDate": "2026-11-06",
    "lastModifyDate": "2026-11-06"
  },
  "links": {
    "manual": [
      "https://www.aliexpress.com"
    ]
  },
  "availableChannels": {
    "Dimmer": {
      "capability": {
        "type": "Intensity",
        "comment": "main dimmer"
      }
    },
    "Red": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Red"
      }
    },
    "Green": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Green"
      }
    },
    "Blue": {
      "capability": {
        "type": "ColorIntensity",
        "color": "Blue"
      }
    },
    "White": {
      "capability": {
        "type": "ColorIntensity",
        "color": "White"
      }
    },
    "Strobe": {
      "capability": {
        "type": "StrobeSpeed",
        "speedStart": "0Hz",
        "speedEnd": "60Hz"
      }
    },
    "Program": {
      "capabilities": [
        {
          "dmxRange": [0, 50],
          "type": "Generic",
          "comment": "controlled by channel 1to6"
        },
        {
          "dmxRange": [51, 100],
          "type": "Generic",
          "comment": "color control by ch8"
        },
        {
          "dmxRange": [101, 150],
          "type": "Effect",
          "effectName": "color change jumping",
          "comment": "speed controlled by ch8"
        },
        {
          "dmxRange": [151, 200],
          "type": "Effect",
          "effectName": "color change smooth",
          "comment": "speed controlled by ch8"
        },
        {
          "dmxRange": [201, 250],
          "type": "Effect",
          "effectName": "color change pulsed",
          "comment": "speed controlled by ch8"
        },
        {
          "dmxRange": [251, 255],
          "type": "Effect",
          "effectName": "sound controlled",
          "soundControlled": true,
          "comment": "controlled by sound"
        }
      ]
    },
    "Effect Speed": {
      "capability": {
        "type": "EffectSpeed",
        "speedStart": "slow",
        "speedEnd": "fast"
      }
    }
  },
  "modes": [
    {
      "name": "8ch",
      "channels": [
        "Dimmer",
        "Red",
        "Green",
        "Blue",
        "White",
        "Strobe",
        "Program",
        "Effect Speed"
      ]
    },
    {
      "name": "4ch",
      "channels": [
        "Red",
        "Green",
        "Blue",
        "White"
      ]
    }
  ]
}
