{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "laser",
  "categories": ["Color Changer"],
  "meta": {
    "authors": ["lightmatt"],
    "createDate": "2026-10-26",
    "lastModifyDate": "2026-10-26"
  },
  "links": {
    "manual": [
      "https://impact-even.com/wp-content/uploads/2024/08/chauvet_colorstrikem_tabledmxv403.pdf"
    ]
  },
  "physical": {
    "DMXconnector": "3-pin",
    "bulb": {
      "lumens": 2000
    }
  },
  "availableChannels": {
    "Intensité": {
      "defaultValue": "0%",
      "capability": {
        "type": "Intensity"
      }
    },
    "Rouge": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "Red"
      }
    },
    "Vert": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "Green"
      }
    },
    "Bleu": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "Blue"
      }
    },
    "Obturateur / Stroboscope": {
      "defaultValue": "0%",
      "capability": {
        "type": "StrobeSpeed",
        "speedStart": "0Hz",
        "speedEnd": "22Hz"
      }
    },
    "UV": {
      "defaultValue": "0%",
      "capability": {
        "type": "ColorIntensity",
        "color": "UV"
      }
    }
  },
  "modes": [
    {
      "name": "ch6",
      "channels": [
        "Intensité",
        "Rouge",
        "Vert",
        "Bleu",
        "Obturateur / Stroboscope",
        "UV"
      ]
    }
  ]
}
