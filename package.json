{
  "name": "open-fixture-library",
  "version": "1.0.0",
  "description": "An open source library for lighting technology's fixture definition files",
  "author": "Florian Edelmann <flo@open-fixture-library.org>",
  "contributors": [
    "Felix Edelmann <fxedel@gmail.com>"
  ],
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "start": "nuxt start",
    "build": "npm run build-without-nuxt && npm run build:nuxt",
    "build-without-nuxt": "npm run build:openapi && npm run build:register && npm run build:plugin-data && npm run build:test-fixtures && npm run build:model-docs && npm run build:api-docs",
    "build:nuxt": "nuxt build",
    "build:openapi": "node cli/build-openapi-bundle.js",
    "build:register": "node cli/build-register.js",
    "build:plugin-data": "node cli/build-plugin-data.js",
    "build:test-fixtures": "node cli/build-test-fixtures.js",
    "build:model-docs": "jsdoc2md --private --files lib/model/*.js > docs/model-api.md",
    "build:api-docs": "widdershins --code true --language_tabs --omitBody true --omitHeader true --resolve true --outfile docs/rest-api.md ui/api/openapi.json && eslint --fix docs/rest-api.md",
    "clean": "rm -rf .nuxt tmp",
    "update-package-lock": "rm package-lock.json && npm install && npm audit fix && npx update-browserslist-db@latest",
    "lint": "npm run lint:eslint && npm run lint:stylelint",
    "lint:eslint": "eslint --cache",
    "lint:eslint-errors-only": "eslint --cache --quiet",
    "lint:stylelint": "stylelint **/*.scss **/*.vue",
    "test": "npm run lint && npm run test:fixtures-valid",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e",
    "test:browser": "playwright test",
    "test:parity": "OLD_URL=http://localhost:3001 NEW_URL=http://localhost:3000 npm run test:e2e",
    "test:dmx-value-scaling": "vitest run --project unit tests/unit/dmx-value-scaling.test.js",
    "test:fixtures-valid": "node tests/fixtures-valid.js -a",
    "test:http-status": "vitest run --project http-status",
    "test:built-files-committed": "node tests/built-files-committed.js"
  },
  "dependencies": {
    "@embetty/server": "^3.2.12",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "@octokit/rest": "~22.0.1",
    "@vee-validate/nuxt": "^4.15.1",
    "@vueuse/nuxt": "^14.3.0",
    "a11y-dialog": "^8.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "color-hash": "^2.0.2",
    "color-name-list": "^14.70.0",
    "embetty-vue-3": "^0.1.7",
    "jszip": "^3.10.2",
    "node-env-file": "^0.1.8",
    "nuxt": "^4.4.7",
    "nuxt-security": "^2.6.0",
    "openapi-backend": "^5.22.0",
    "sanitize-filename": "^1.6.4",
    "sass": "^1.105.2",
    "scroll-into-view": "^1.16.2",
    "unstorage": "^1.17.5",
    "uuid": "^14.0.2",
    "vee-validate": "^4.15.1",
    "vue-ts-types": "^1.10.0",
    "vuedraggable": "^4.1.0",
    "xml2js": "^0.6.2",
    "xmlbuilder": "^15.1.1"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@eslint/js": "~10.0.1",
    "@eslint/markdown": "~8.0.3",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@stylistic/stylelint-config": "~5.0.0",
    "@types/node": "^22.19.20",
    "@vitest/eslint-plugin": "^1.6.27",
    "broken-link-checker": "^0.7.8",
    "dir-compare": "^5.0.0",
    "disparity": "^3.2.0",
    "eslint": "~10.13.0",
    "eslint-plugin-import-x": "~4.17.1",
    "eslint-plugin-jsdoc": "~65.0.0",
    "eslint-plugin-jsonc": "~3.4.2",
    "eslint-plugin-promise": "~7.3.0",
    "eslint-plugin-sonarjs": "~4.2.2",
    "eslint-plugin-unicorn": "~78.0.0",
    "eslint-plugin-vue": "~10.11.1",
    "eslint-plugin-vuejs-accessibility": "~2.6.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jsdoc-to-markdown": "^9.1.3",
    "libxml2-wasm": "^0.7.2",
    "minimist": "^1.2.8",
    "playwright": "^1.64.1",
    "postcss-html": "^2.0.0",
    "stylelint": "~17.16.0",
    "stylelint-config-html": "~2.0.0",
    "stylelint-config-recess-order": "~7.8.2",
    "stylelint-config-standard-scss": "~17.0.0",
    "stylelint-order": "~8.1.1",
    "terminate": "^2.8.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "~10.4.1",
    "widdershins": "^4.0.1"
  },
  "overrides": {
    "broken-link-checker@^0.7.8": {
      "useragent@2.3.0": {
        "tmp": "^0.2.7"
      }
    },
    "widdershins@^4.0.1": {
      "httpsnippet@1.25.0": {
        "form-data": "3.0.5"
      }
    }
  },
  "homepage": "https://open-fixture-library.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenLightingProject/open-fixture-library"
  },
  "keywords": [
    "dmx",
    "dmx512",
    "ecue",
    "fixture",
    "fixtures",
    "lighting",
    "qlc"
  ],
  "license": "MIT",
  "allowScripts": {
    "core-js@3.29.1": true,
    "core-js@3.50.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
