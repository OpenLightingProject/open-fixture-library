{
  "get": {
    "operationId": "getPlugins",
    "description": "Returns general information about import and export plugins.",
    "tags": ["plugins"],
    "responses": {
      "200": {
        "headers": {
          "Content-Type": {
            "$ref": "../../openapi.json#/components/headers/Content-Type"
          },
          "Access-Control-Allow-Origin": {
            "$ref": "../../openapi.json#/components/headers/Access-Control-Allow-Origin"
          },
          "Vary": {
            "$ref": "../../openapi.json#/components/headers/Vary"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "importPlugins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exportPlugins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "data": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "outdated": {
                        "type": "boolean",
                        "enum": [true]
                      },
                      "newPlugin": {
                        "type": "string"
                      },
                      "importPluginVersion": {
                        "type": "string"
                      },
                      "exportPluginVersion": {
                        "type": "string"
                      },
                      "exportTests": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "allOf": [
                      {
                        "oneOf": [
                          { "required": ["outdated", "newPlugin"] },
                          {
                            "not": {
                              "anyOf": [
                                { "required": ["outdated"] },
                                { "required": ["newPlugin"] }
                              ]
                            }
                          }
                        ]
                      },
                      {
                        "oneOf": [
                          { "required": ["exportPluginVersion", "exportTests"] },
                          {
                            "not": {
                              "anyOf": [
                                { "required": ["exportPluginVersion"] },
                                { "required": ["exportTests"] }
                              ]
                            }
                          }
                        ]
                      }
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "importPlugins",
                "exportPlugins",
                "data"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "400": {
        "$ref": "../../openapi.json#/components/responses/400-BadRequestError"
      }
    }
  }
}
