{
  "parameters": [
    {
      "name": "pluginKey",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+$"
      }
    }
  ],
  "get": {
    "operationId": "getPluginByKey",
    "description": "Returns information about a specific import and export plugin. If an outdated plugin is requested, the information for the renamed plugin is returned.",
    "tags": ["plugins"],
    "responses": {
      "200": {
        "description": "Plugin details returned",
        "headers": {
          "Content-Type": {
            "$ref": "../../openapi.json#/components/headers/Content-Type"
          },
          "Access-Control-Allow-Origin": {
            "$ref": "../../openapi.json#/components/headers/Access-Control-Allow-Origin"
          },
          "Vary": {
            "$ref": "../../openapi.json#/components/headers/Vary"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "previousVersions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string"
                },
                "links": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "fixtureUsage": {
                  "type": "string"
                },
                "fileLocations": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "subDirectoriesAllowed": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "main": {
                        "type": "string"
                      },
                      "user": {
                        "type": "string"
                      }
                    }
                  }
                },
                "additionalInfo": {
                  "type": "string"
                },
                "helpWanted": {
                  "type": "string"
                },
                "exportPluginVersion": {
                  "type": "string"
                },
                "importPluginVersion": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "name",
                "previousVersions",
                "description",
                "links"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "400": {
        "$ref": "../../openapi.json#/components/responses/400-BadRequestError"
      },
      "404": {
        "$ref": "../../openapi.json#/components/responses/404-NotFoundError"
      }
    }
  }
}
