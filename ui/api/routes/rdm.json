{
  "get": {
    "operationId": "getRdmLookup",
    "description": "Returns the manufacturer and fixture matching the given RDM IDs.",
    "tags": ["rdm"],
    "parameters": [
      {
        "name": "manufacturerId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      {
        "name": "modelId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    ],
    "responses": {
      "200": {
        "description": "RDM lookup result returned",
        "headers": {
          "Content-Type": {
            "$ref": "../openapi.json#/components/headers/Content-Type"
          },
          "Access-Control-Allow-Origin": {
            "$ref": "../openapi.json#/components/headers/Access-Control-Allow-Origin"
          },
          "Vary": {
            "$ref": "../openapi.json#/components/headers/Vary"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "manufacturerKey": {
                  "type": "string",
                  "nullable": true
                },
                "manufacturerName": {
                  "type": "string",
                  "nullable": true
                },
                "fixtureKey": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "manufacturerKey",
                "manufacturerName",
                "fixtureKey"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/400-BadRequestError"
      }
    }
  }
}
